# Salin file ini jadi ".env" dan isi sesuai punyamu. JANGAN commit .env asli ke git.

PORT=4000

# Domain tempat Admin Auth System di-deploy (frontend), boleh lebih dari satu
# dipisah koma. Ini yang diizinkan memanggil API auth-bridge ini.
ALLOWED_ORIGIN=https://auth.nugroho.store,http://localhost:5500

# --- Pilih SALAH SATU cara berikut untuk kredensial Firebase Admin SDK ---

# Cara 1 (disarankan untuk hosting seperti Render/Railway/Cloud Run):
# tempel seluruh isi file service-account.json sebagai satu baris JSON di sini.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"store-6d392", ...}

# Cara 2 (untuk server sendiri/VPS): taruh file service-account.json di server,
# lalu arahkan path-nya di sini.
# GOOGLE_APPLICATION_CREDENTIALS=/path/aman/di/server/service-account.json
